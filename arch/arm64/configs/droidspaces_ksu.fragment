# Droidspaces + KernelSU-Next options, merged on top of yunluo_device_base.config.
#
# The device's vendor modules are prebuilt; their genksyms CRCs don't match any
# rebuildable tree, so kernel/module.c is patched to accept them (see
# patch_modversions.py). With CRC checks relaxed, actual struct LAYOUT is what
# matters. Layout-affecting options must go through the Droidspaces kABI
# patches (task_struct: sysvsem/sysvshm into ANDROID_KABI_RESERVE(7,8), mqueue
# into ABI padding) so prebuilt modules keep working.

# KernelSU-Next (kprobe-based)
CONFIG_KSU=y

# Force the GLOBAL stack protector guard: newer clang auto-enables the
# per-task sysreg guard (STACKPROTECTOR_PER_TASK def_bool y), which stops
# exporting __stack_chk_guard — a symbol 139 prebuilt vendor modules import.
# CONFIG_STACKPROTECTOR_PER_TASK is not set

# --- Droidspaces core (fatal requirements) ---
# IPC, layout preserved via Droidspaces kABI patches
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
# devtmpfs (Droidspaces /dev setup)
CONFIG_DEVTMPFS=y
# Cgroups
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Droidspaces networking (NAT mode / UFW / Fail2ban) ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# tmpfs xattr / posix acl (NixOS support)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Build pragmatics:
#  - keep base LTO_CLANG_FULL + CFI_CLANG: modules import __cfi_slowpath, so
#    CFI must stay enabled (LTO_NONE would disable it and break every module)
#  - DEBUG_INFO off: full-LTO link OOMs the 16 GB CI runner with debug info
# CONFIG_DEBUG_INFO is not set
# device base config points UNUSED_KSYMS_WHITELIST at a nonexistent path
# CONFIG_TRIM_UNUSED_KSYMS is not set
# shallow clone has no tags for LOCALVERSION_AUTO
CONFIG_LOCALVERSION="-ksu-droidspaces"
# CONFIG_LOCALVERSION_AUTO is not set

# Deliberately NOT enabled: CONFIG_USER_NS (grows struct cred — real layout
# change with no kABI padding available on 5.10). Optional per Droidspaces docs
# (docker-in-container fix only).
