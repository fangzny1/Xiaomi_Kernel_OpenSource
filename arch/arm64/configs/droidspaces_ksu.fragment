# Kernel configuration fragment for Droidspaces (https://github.com/ravindu644/Droidspaces-OSS)
# and KernelSU-Next (https://github.com/KernelSU-Next/KernelSU-Next) support.
# Merge on top of gki_defconfig; requires the Droidspaces kABI patches for
# SYSVIPC / POSIX_MQUEUE on 5.10 GKI kernels.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# HW access
CONFIG_DEVTMPFS=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Cgroups
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

# Networking (NAT mode / UFW / Fail2ban)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# tmpfs xattr / posix acl (NixOS support)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# KernelSU-Next
CONFIG_KSU=y

# Disable thinLTO: full-GKI LTO link OOMs on 16 GB CI runners,
# and LTO does not affect the kernel ABI
CONFIG_LTO_NONE=y
