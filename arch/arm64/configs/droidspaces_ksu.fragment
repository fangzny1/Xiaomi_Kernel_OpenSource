# Droidspaces + KernelSU-Next options for yunluo_device_base.config.
#
# IMPORTANT: the device's 187 first-stage vendor modules are prebuilt and
# checked against genksyms symbol CRCs (CONFIG_MODVERSIONS). Any option that
# changes a struct declaration referenced by exported symbols (task_struct,
# css_set, ...) breaks module loading even when the kABI padding patches keep
# the actual layout identical. Therefore only declaration-neutral options are
# enabled here; the ABI-affecting Droidspaces options are listed at the bottom
# and must be re-evaluated against kernel_crcs.txt after every change.

# KernelSU-Next (kprobe-based; no declaration changes)
CONFIG_KSU=y

# devtmpfs (Droidspaces /dev setup) — initcalls only, no ABI impact
CONFIG_DEVTMPFS=y

# Networking (NAT mode / UFW / Fail2ban) — config-only, no ABI impact
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# tmpfs xattr / posix acl (NixOS support) — no ABI impact
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Build pragmatics — no ABI impact
# full-GKI LTO link OOMs on 16 GB CI runners; LTO does not affect module CRCs
CONFIG_LTO_NONE=y
# device base config points UNUSED_KSYMS_WHITELIST at a path that does not exist here
# CONFIG_TRIM_UNUSED_KSYMS is not set
# shallow clone has no tags for LOCALVERSION_AUTO
CONFIG_LOCALVERSION="-ksu-droidspaces"
# CONFIG_LOCALVERSION_AUTO is not set

# ---------------------------------------------------------------------------
# ABI-AFFECTING Droidspaces options — OFF for now, evaluate with CRC dump:
#   CONFIG_SYSVIPC / CONFIG_POSIX_MQUEUE (task_struct: sysvsem/sysvshm)
#   CONFIG_IPC_NS / CONFIG_PID_NS
#   CONFIG_CGROUP_DEVICE / CONFIG_CGROUP_PIDS (css_set->subsys[] size)
#   CONFIG_USER_NS (cred->user_ns)
# Droidspaces-fatal ones need vendor modules rebuilt against the new kernel.
